# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / APP_BASE_URL: The URL where this applet is hosted.
# AI Studio automatically injects APP_URL at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, API endpoints, and password reset links.
APP_URL="MY_APP_URL"
APP_BASE_URL="http://localhost:3000"

# SMTP E-mail Configuration for Password Reset and Notifications
# Configure these variables to enable sending emails via SMTP.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="usuario@exemplo.com"
SMTP_PASSWORD="sua_senha_smtp"
SMTP_FROM_NAME="PK SIG Assistência"
SMTP_FROM_EMAIL="atendimento@exemplo.com"

